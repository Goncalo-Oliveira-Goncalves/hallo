<div id="<%= dom_id user %>">
  <div>
    <strong>Profile picture url:</strong>
    <%= user.profile_picture_url %>
  </div>

  <div>
    <strong>Phone:</strong>
    <%= user.phone %>
  </div>

  <div>
    <strong>First name:</strong>
    <%= user.first_name %>
  </div>

  <div>
    <strong>Last name:</strong>
    <%= user.last_name %>
  </div>

  <div>
    <strong>Country or region:</strong>
    <%= user.country_or_region %>
  </div>

  <div>
    <strong>Street address p1:</strong>
    <%= user.street_address_p1 %>
  </div>

  <div>
    <strong>Street address p2:</strong>
    <%= user.street_address_p2 %>
  </div>

  <div>
    <strong>City:</strong>
    <%= user.city %>
  </div>

  <div>
    <strong>State province region:</strong>
    <%= user.state_province_region %>
  </div>

  <div>
    <strong>Zip:</strong>
    <%= user.zip %>
  </div>

  <div>
    <strong>Cart:</strong>
    <%= user.cart %>
  </div>

</div>
