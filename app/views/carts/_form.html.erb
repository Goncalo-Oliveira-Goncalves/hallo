<%= form_with(model: cart) do |form| %>
  <% if cart.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(cart.errors.count, "error") %> prohibited this cart from being saved:</h2>

      <ul>
        <% cart.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :userid, style: "display: block" %>
    <%= form.number_field :userid %>
  </div>

  <div>
    <%= form.label :productid, style: "display: block" %>
    <%= form.number_field :productid %>
  </div>

  <div>
    <%= form.label :productquantity, style: "display: block" %>
    <%= form.number_field :productquantity %>
  </div>

  <div>
    <%= form.label :state, style: "display: block" %>
    <%= form.text_field :state %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
