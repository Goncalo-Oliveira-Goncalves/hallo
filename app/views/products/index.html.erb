<p style="color: green"><%= notice %></p>

<% content_for :title, "Products" %>

<div>
  <h1>Products</h1>

  <div id="products">
    <% @products.each do |product| %>
      <div class="<%= case product.priority
        when 0 then 'priority-high'
        when 1 then 'priority-medium'
        when 2 then 'priority-low'
        else 'priority-default'
      end %>">
        <%= render product %>

        <%= link_to "CHECK IT OUT", product, class: 'cta-link' %>
      </div>
    <% end %>
  </div>

  <%= link_to "New product", new_product_path %>
</div>
