<div id="<%= dom_id product %>">
  <div>
    <strong>Name:</strong>
    <%= product.name %>
  </div>

  <div>
    <strong>Short description:</strong>
    <%= product.short_description %>
  </div>

  <div>
    <strong>Display image link:</strong>
    <%= product.display_image_link %>
  </div>

  <div>
    <strong>Priority:</strong>
    <%= product.priority %>
  </div>

  <div>
    <strong>In stock:</strong>
    <%= product.in_stock %>
  </div>

  <div>
    <strong>Color:</strong>
    <%= product.color %>
  </div>

  <div>
    <strong>Parent product:</strong>
    <%= product.parent_product %>
  </div>

  <div>
    <strong>Long description:</strong>
    <%= product.long_description %>
  </div>

  <div>
    <strong>Dimension x:</strong>
    <%= product.dimension_x %>
  </div>

  <div>
    <strong>Dimension y:</strong>
    <%= product.dimension_y %>
  </div>

  <div>
    <strong>Dimension z:</strong>
    <%= product.dimension_z %>
  </div>

  <div>
    <strong>Weight:</strong>
    <%= product.weight %>
  </div>

</div>
