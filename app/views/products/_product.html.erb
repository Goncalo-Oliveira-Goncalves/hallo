<div id="<%= dom_id product %>" class="shoppercard">
  <div>
    <div class="name">
      <%= product.name %>
    </div>

    <div class="description">
      <%= product.short_description %>

      <%# the bellow code is added as a tag at the end of the description %>
      <% if product.in_stock < 5 %>
        <div class="in-stock">
          <%= product.in_stock %> in stock
        </div>
      <% end %>
    </div>
  </div>
    
  <div class="image-link">
    <img src=<%= product.display_image_link %> alt="product image">
  </div>
</div>
